# ============================================================
# 부동산 트래커 환경 변수
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요
# ============================================================

# ── API 키 설정 ──────────────────────────────────────────────────
#
# ⚠️  두 서비스는 서로 다른 플랫폼이므로 각각 별도 키를 발급받아야 합니다.
#
# [1] 실거래 데이터 API 키 (공공데이터포털 data.go.kr)
#     발급 방법:
#       1. https://www.data.go.kr 회원가입
#       2. '한국부동산원 아파트매매 실거래 신고 자료' 검색 → 활용 신청
#       3. 마이페이지 → 개발계정 → 일반 인증키(Decoding) 복사
DATA_GO_KR_API_KEY=여기에_data.go.kr_API_키_입력

# [2] R-ONE 부동산통계정보 API 키 (한국부동산원 reb.or.kr)
#     발급 방법:
#       1. https://www.reb.or.kr/r-one 회원가입 후 로그인
#       2. Open API 메뉴 → 인증키 발급내역 → 인증키 신청
#       ※ 키 없이도 sample 키로 조회 가능 (10건 제한)
REB_STATS_API_KEY=여기에_reb.or.kr_API_키_입력

# ── 서버 설정 ────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── 프론트엔드 설정 ──────────────────────────────────────────
# 개발 시에는 Vite proxy가 자동으로 /api → localhost:3001 으로 연결
# 프로덕션 배포 시에는 실제 서버 URL 입력
VITE_API_BASE_URL=http://localhost:3001/api
