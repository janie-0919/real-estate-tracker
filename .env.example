# ============================================================
# 부동산 트래커 환경 변수
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요
# ============================================================

# ── 국토교통부 실거래가 공공 API 키 (필수) ──────────────────────
# 발급 방법:
#   1. https://www.data.go.kr 회원가입
#   2. '아파트매매실거래상세자료' 검색 → 활용 신청
#   3. 마이페이지 → 개발계정 → API 키 확인 (인코딩 키 사용)
MOLIT_API_KEY=여기에_API_키_입력

# ── 한국부동산원(R-ONE) 부동산통계정보 API 키 (선택) ─────────────
# 제공 데이터: 아파트 매매/전세 가격지수, 주간/월간 전국·지역별
# 발급 방법:
#   1. https://www.reb.or.kr/r-one 회원가입 후 로그인
#   2. Open API 메뉴 → API 목록 → 원하는 통계 선택 → 인증키 신청
#   3. 발급된 KEY 값을 아래에 입력
# 미설정 시: 'sample' 키로 동작 (결과 10건 제한)
REB_API_KEY=여기에_REB_API_키_입력

# ── 서버 설정 ────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── 프론트엔드 설정 ──────────────────────────────────────────
# 개발 시에는 Vite proxy가 자동으로 /api → localhost:3001 으로 연결
# 프로덕션 배포 시에는 실제 서버 URL 입력
VITE_API_BASE_URL=http://localhost:3001/api
