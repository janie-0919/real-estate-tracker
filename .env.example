# ============================================================
# 부동산 트래커 환경 변수
# 이 파일을 복사해서 .env 로 저장하고 값을 채워주세요
# ============================================================

# ── 한국부동산원(REB) API 키 ──────────────────────────────────────
#
# [1] 실거래 데이터 (data.go.kr - B552554 한국부동산원 서비스)
#     발급 방법:
#       1. https://www.data.go.kr 회원가입
#       2. '한국부동산원 아파트매매 실거래 신고 자료' 검색 → 활용 신청
#       3. 마이페이지 → 개발계정 → 일반 인증키(Decoding) 복사
#
# [2] R-ONE 부동산통계정보 (reb.or.kr - 가격지수/통계)
#     발급 방법:
#       1. https://www.reb.or.kr/r-one 회원가입 후 로그인
#       2. Open API 메뉴 → API 목록 → 원하는 통계 선택 → 인증키 신청
#
# 두 서비스 모두 동일한 키를 사용하거나 각각 발급받아 설정하세요.
REB_API_KEY=여기에_API_키_입력

# ── 서버 설정 ────────────────────────────────────────────────
PORT=3001
CORS_ORIGIN=http://localhost:5173

# ── 프론트엔드 설정 ──────────────────────────────────────────
# 개발 시에는 Vite proxy가 자동으로 /api → localhost:3001 으로 연결
# 프로덕션 배포 시에는 실제 서버 URL 입력
VITE_API_BASE_URL=http://localhost:3001/api
